GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace_with_a_unique_random_secret
BETTER_AUTH_URL=http://localhost:3000
# Set on staging only, with comma-separated tester emails. An empty value denies everyone.
# STAGING_ALLOWED_EMAILS=owner@example.com,tester@example.com
# Comma-separated development hosts permitted to sign in over your local network.
BETTER_AUTH_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,192.168.86.162:*

# Set both to enable email verification through Resend on this deployment.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Local Next.js development only: print the verification link to the terminal.
AUTH_EMAIL_DEV_LOG=false

# Optional social sign-in. Leave a provider blank to hide its button.
# In each provider dashboard, add:
# https://your-domain.example/api/auth/callback/google (or apple / facebook)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# PostgreSQL / Neon (leave blank while using the existing local SQLite prototype)
DATABASE_URL=
POSTGRES_SSL=true
# Do not change this until all server-side stores are migrated and tested.
DATABASE_DRIVER=sqlite

# Video storage: use `local` for development. `data/uploads` is gitignored.
VIDEO_STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./data/uploads
# Optional override for the bundled server-side video validator executable.
FFMPEG_PATH=
# Enable after adding the web origin to the R2 bucket's CORS rules.
VIDEO_DIRECT_UPLOADS=false

# Cloudflare R2 (required only when VIDEO_STORAGE_DRIVER=r2).
# Create an R2 API token with Object Read & Write access limited to this bucket.
# R2_ENDPOINT may be omitted when R2_ACCOUNT_ID is supplied.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
# Optional Pro trial length. Leave blank to track enrollment without setting an end date.
PRO_TRIAL_DAYS=
